@model List<EnrolmentDto>
@{
    ViewData["Title"] = "My events";
}
<h1 class="mb-3">My events</h1>
@if (Model.Count == 0)
{
    <div class="empty-state">
        <p>You have not enrolled for any events yet.</p>
        <a asp-controller="Home" asp-action="Index" class="btn rd-btn">Browse events</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table rd-table align-middle">
            <thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Enrolled on</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var enrolment in Model)
                {
                    <tr>
                        <td><a asp-controller="Events" asp-action="Details" asp-route-id="@enrolment.EventId">@enrolment.EventName</a></td>
                        <td>@Display.Date(enrolment.EventDate)</td>
                        <td>@enrolment.CategoryName</td>
                        <td>@Display.Date(enrolment.EnrolmentDate)</td>
                        <td><partial name="_StatusBadge" model="@enrolment.Status" /></td>
                        <td class="text-end">
                            @if (enrolment.Status == "Confirmed" && enrolment.EventDate.Date >= DateTime.Today)
                            {
                                <form asp-controller="Participant" asp-action="Cancel" asp-route-id="@enrolment.EnrolmentId" method="post" class="d-inline"
                                      onsubmit="return confirm('Cancel this enrolment?');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Cancel</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
