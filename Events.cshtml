@model List<EventSummaryDto>
@{
    ViewData["Title"] = "Manage events";
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="mb-0">Manage events</h1>
    <a asp-action="CreateEvent" class="btn rd-btn">+ Create event</a>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">You have not created any events yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table rd-table align-middle">
            <thead><tr><th>Event</th><th>Type</th><th>Date</th><th>Distance</th><th>Enrolments</th><th></th></tr></thead>
            <tbody>
                @foreach (var ev in Model)
                {
                    <tr>
                        <td>
                            <strong>@ev.EventName</strong>
                            <div class="text-muted small">@ev.Location</div>
                        </td>
                        <td><span class="type-pill type-@ev.EventType.ToLowerInvariant()">@ev.EventType</span></td>
                        <td>@Display.Date(ev.EventDate)</td>
                        <td>@ev.DistanceKm.ToString("0.#") km</td>
                        <td><span class="count-pill">@ev.TotalEnrolments</span></td>
                        <td class="text-end text-nowrap">
                            <a asp-action="EditEvent" asp-route-id="@ev.EventId" class="btn btn-outline-secondary btn-sm">Edit</a>
                            <a asp-action="Categories" asp-route-eventId="@ev.EventId" class="btn btn-outline-secondary btn-sm">Categories</a>
                            <a asp-action="Enrolments" asp-route-eventId="@ev.EventId" class="btn btn-outline-secondary btn-sm">Enrolments</a>
                            <a asp-action="Results" asp-route-eventId="@ev.EventId" class="btn btn-outline-secondary btn-sm">Results</a>
                            <form asp-action="DeleteEvent" asp-route-id="@ev.EventId" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this event? This cannot be undone.');">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
