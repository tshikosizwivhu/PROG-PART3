@model EventDto
<div class="card event-card h-100">
    @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
    {
        <img src="@Model.BannerImageUrl" class="event-banner" alt="@Model.EventName banner" />
    }
    else
    {
        <div class="event-banner event-banner-empty"><span>@Model.EventType</span></div>
    }
    <div class="card-body d-flex flex-column">
        <span class="type-pill type-@Model.EventType.ToLowerInvariant()">@Model.EventType</span>
        <h5 class="card-title mt-2">@Model.EventName</h5>
        <p class="text-muted mb-1">@Display.Date(Model.EventDate)</p>
        <p class="mb-1">@Model.Location</p>
        <p class="mb-3"><strong>@Model.DistanceKm.ToString("0.#") km</strong></p>
        <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId" class="btn rd-btn mt-auto">View event</a>
    </div>
</div>
