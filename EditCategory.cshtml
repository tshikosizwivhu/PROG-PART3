@model CategoryFormViewModel
@{
    ViewData["Title"] = "Edit category";
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card form-card">
            <div class="card-body">
                <h2 class="mb-3">Edit category</h2>
                <form asp-controller="Organiser" asp-action="EditCategory" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                    <input type="hidden" asp-for="CategoryId" />
                    <input type="hidden" asp-for="EventId" />
                    <div class="mb-3">
                        <label asp-for="CategoryName" class="form-label"></label>
                        <input asp-for="CategoryName" class="form-control" />
                        <span asp-validation-for="CategoryName" class="text-danger"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="DistanceKm" class="form-label"></label>
                            <input asp-for="DistanceKm" type="number" step="0.1" class="form-control" />
                            <span asp-validation-for="DistanceKm" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="EntryFee" class="form-label"></label>
                            <input asp-for="EntryFee" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="EntryFee" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="MaxParticipants" class="form-label"></label>
                            <input asp-for="MaxParticipants" type="number" class="form-control" />
                            <span asp-validation-for="MaxParticipants" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn rd-btn">Save category</button>
                        <a asp-action="Categories" asp-route-eventId="@Model.EventId" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
