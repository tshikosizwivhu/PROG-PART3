# Copy this file to ".env" (same folder as docker-compose.yml) and fill it in.
# The .env file is ignored by Git so your secrets are never uploaded.

# Azure Storage account connection string (Azure portal > Storage account > Security + networking > Access keys)
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net"
AZURE_BLOB_CONTAINER=raceday-images

# Password for the SQL Server container (letters, numbers and underscores only)
SA_PASSWORD=RaceDay_Strong_2026
